{
  "name": "@cpf/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CPF web application — employer portal, reviewer workspace, candidate portal, and platform administration against the CPF API. No mock data: every screen talks to the real API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cpf/assessment-framework": "*",
    "cookie-es": "^3.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.12.1",
    "happy-dom": "^20.11.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
