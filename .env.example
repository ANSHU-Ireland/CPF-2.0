# CPF API — environment variable reference (copy to .env, never commit real values)

# --- Runtime ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000

# --- Database (local docker-compose defaults; cpf_api is a non-superuser
#     member of cpf_app — the API must never connect as a superuser) ---
DATABASE_URL=postgresql://cpf_api:cpf_local_dev@localhost:5432/cpf

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_48_BYTE_RANDOM_VALUE

# --- AI Gateway (Phase 2+; leave unset to disable AI features entirely) ---
# AI_GATEWAY_PROVIDER=
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_DATA_REGION=eu

# --- Observability (Step 33; both optional, off/no-op by default) ---
# Exposes GET /metrics (Prometheus text format). Only enable on a listener
# that isn't reachable from the public internet — there is no
# application-level auth on this endpoint.
METRICS_ENABLED=false
# Standard OpenTelemetry env var. Unset = tracing SDK never starts (no-op).
# Point this at your OTLP/HTTP collector endpoint to enable it, e.g.:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
