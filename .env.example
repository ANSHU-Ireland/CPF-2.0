# CPF API — environment variable reference (copy to .env, never commit real values)
# Full table with defaults/requiredness/notes: docs/operations/operations-and-runbooks.md

# --- Runtime ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000

# --- Database (local docker-compose defaults; cpf_api is a non-superuser
#     member of cpf_app — the API must never connect as a superuser).
#     Required in production — the API refuses to start without it there. ---
DATABASE_URL=postgresql://cpf_api:cpf_local_dev@localhost:5432/cpf

# --- Outbound mail (optional — unset SMTP_HOST uses the console adapter,
#     which logs message metadata only and never actually delivers) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@cpf.invalid

# --- AI Gateway (Phase 2+; leave unset to disable AI features entirely) ---
# AI_GATEWAY_PROVIDER=
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_DATA_REGION=eu
