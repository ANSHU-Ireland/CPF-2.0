# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment & secrets — never commit
.env
.env.*
!.env.example

# Local extraction workspace (source documents are not committed)
.tmp-extract/

# Throwaway local PostgreSQL instance for integration testing
.tmp-pg/

# Test & coverage output
coverage/
.vitest/

# Generated seed output (regenerate with npm run seed:generate)
packages/db/seed/generated/

# Generated SBOM artifact (regenerate with npx @cyclonedx/cyclonedx-npm; CI uploads it)
sbom.cdx.json

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json
